{
  "name": "rnk-vortex-system-optimizer",
  "version": "3.1.1",
  "description": "RNK Vortex System Optimizer - bounded whole-PC optimization with explicit local approvals",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --verbose",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "verify": "npm test -- --runInBand && node scripts/verify-coverage.mjs && npm run lint && node --check native/cli.mjs && node --check native/cli-maintenance.mjs && node --check native/cli-media.mjs && node --check native/cli-utils.mjs && node --check native/browser-bridge.mjs && node --check scripts/pc-host-benchmark.mjs && node --check scripts/verify-coverage.mjs && node --check scripts/verify-release-provenance.mjs && node --check scripts/verify-public-boundary.mjs && node scripts/verify-public-boundary.mjs && npm run bench -- --json",
    "bench": "node scripts/pc-host-benchmark.mjs",
    "lint": "eslint scripts/**/*.js native/**/*.js native/**/*.mjs browser/**/*.js",
    "lint:fix": "eslint scripts/**/*.js native/**/*.js native/**/*.mjs browser/**/*.js --fix",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:high": "npm audit --audit-level=high",
    "native:facts": "node native/cli.mjs facts",
    "native:optimize": "node native/cli.mjs optimize",
    "native:cache:preview": "node native/cli.mjs cache-preview",
    "native:cache:quarantine:preview": "node native/cli.mjs cache-quarantine-preview",
    "native:cache:quarantine:apply": "node native/cli.mjs cache-quarantine-apply",
    "native:cache:quarantine:rollback": "node native/cli.mjs cache-quarantine-rollback",
    "native:organize:preview": "node native/cli.mjs organize-preview",
    "native:file:inspect": "node native/cli.mjs file-inspect",
    "native:storage:preview": "node native/cli.mjs storage-preview",
    "native:storage:cleanup": "node native/cli.mjs storage-cleanup",
    "native:storage:monitor": "node native/cli.mjs storage-monitor",
    "native:steward:history": "node native/cli.mjs steward-history",
    "native:steward:monitor": "node native/cli.mjs steward-monitor",
    "native:steward:schedule": "node native/cli.mjs steward-schedule",
    "native:report:schedule:preview": "node native/cli.mjs report-schedule-preview",
    "native:report:schedule:apply": "node native/cli.mjs report-schedule-apply",
    "native:report:schedule:restore": "node native/cli.mjs report-schedule-restore",
    "native:steward:daemon": "node native/cli.mjs steward-daemon",
    "native:steward:report": "node native/cli.mjs steward-report",
    "native:steward:snapshot": "node native/cli.mjs steward-snapshot",
    "native:steward:trends": "node native/cli.mjs steward-trends",
    "native:workload:preview": "node native/cli.mjs workload-preview",
    "native:workload:apply": "node native/cli.mjs workload-apply",
    "native:workload:budget:preview": "node native/cli.mjs workload-budget-preview",
    "native:workload:budget:apply": "node native/cli.mjs workload-budget-apply",
    "native:resource:preview": "node native/cli.mjs resource-limit-preview",
    "native:resource:apply": "node native/cli.mjs resource-limit-apply",
    "native:game:session": "node native/cli.mjs game-session-monitor",
    "native:drive:health": "node native/cli.mjs drive-health",
    "native:report:open": "node native/cli.mjs report-open",
    "native:steward:dashboard": "node native/cli.mjs steward-dashboard",
    "native:steward:tray": "node native/cli.mjs steward-tray",
    "native:steward:storage-guard": "node native/cli.mjs storage-monitor --target-free-gb 5 --interval-seconds 60",
    "package:workstation": "node scripts/workstation-package.js",
    "native:filesystem:health": "node native/cli.mjs filesystem-health",
    "native:drive:benchmark": "node native/cli.mjs drive-benchmark",
    "native:network:overview": "node native/cli.mjs network-overview",
    "native:network:monitor": "node native/cli.mjs network-rate-monitor",
    "native:network:contention": "node native/cli.mjs network-monitor",
    "native:process:monitor": "node native/cli.mjs process-rate-monitor",
    "native:policy:preview": "node native/cli.mjs policy-preview",
    "native:policy:approve": "node native/cli.mjs policy-approve",
    "native:placement:preview": "node native/cli.mjs placement-preview",
    "native:placement:apply": "node native/cli.mjs placement-apply",
    "native:placement:rollback": "node native/cli.mjs placement-rollback",
    "native:placement:policy:preview": "node native/cli.mjs placement-policy-preview",
    "native:placement:policy:apply": "node native/cli.mjs placement-policy-apply",
    "native:assistant": "node native/cli.mjs assistant",
    "native:power:preview": "node native/cli.mjs power-preview",
    "native:power:apply": "node native/cli.mjs power-apply",
    "native:power:recommend": "node native/cli.mjs power-recommend",
    "native:gpu:policy:preview": "node native/cli.mjs gpu-policy-preview",
    "native:gpu:policy:apply": "node native/cli.mjs gpu-policy-apply",
    "native:power:monitor": "node native/cli.mjs power-monitor",
    "native:process:overview": "node native/cli.mjs process-overview",
    "native:process:stop-preview": "node native/cli.mjs process-stop-preview",
    "native:process:stop-apply": "node native/cli.mjs process-stop-apply",
    "native:startup:preview": "node native/cli.mjs startup-preview",
    "native:startup:apply": "node native/cli.mjs startup-apply",
    "native:download:preflight": "node native/cli.mjs download-preflight",
    "native:download:scan": "node native/cli.mjs download-scan",
    "native:download:monitor": "node native/cli.mjs download-monitor",
    "native:download:verify": "node native/cli.mjs download-verify",
    "native:gateway:verify": "node native/cli.mjs gateway-verify",
    "native:windows:rog": "node native/cli.mjs windows-rog-verify",
    "release:attestation": "node scripts/create-release-attestation.mjs",
    "native:download:bridge": "node native/browser-bridge.mjs",
    "native:media:scan": "node native/cli.mjs media-scan",
    "native:media:read": "node native/cli.mjs media-read",
    "native:media:favorite": "node native/cli.mjs media-favorite",
    "native:media:played": "node native/cli.mjs media-played",
    "native:media:playlist": "node native/cli.mjs media-playlist",
    "native:media:export": "node native/cli.mjs media-export",
    "native:media:import": "node native/cli.mjs media-import",
    "native:media:playback-plan": "node native/cli.mjs media-playback-plan",
    "native:media:play": "node native/cli.mjs media-play",
    "native:media:player": "node native/cli.mjs media-player",
    "native:media:player:play": "node native/cli.mjs media-player --action play",
    "native:media:panel": "node native/cli.mjs media-panel",
    "native:media:panel:open": "node native/cli.mjs media-panel-open",
    "native:media:metadata": "node native/cli.mjs media-metadata"
  },
  "keywords": [
    "pc-optimizer",
    "optimization",
    "performance",
    "rnk-vortex"
  ],
  "author": "Lisa's Dungeon",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "jest": "^30.5.2"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "collectCoverageFrom": [
      "pc/**/*.js",
      "scripts/pc-host-benchmark.js",
      "scripts/release-provenance.js",
      "scripts/pc-media-player.js",
      "native/**/*.js",
      "native/gateway-url.js",
      "native/cli-utils.mjs",
      "native/cli-media.mjs",
      "native/cli-maintenance.mjs",
      "native/cli.mjs",
      "native/browser-bridge.mjs",
      "scripts/verify-public-boundary.mjs",
      "scripts/verify-release-provenance.mjs",
      "scripts/verify-coverage.mjs",
      "scripts/pc-host-benchmark.mjs",
      "scripts/workstation-package.js",
      "browser/**/*.js"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^file://(.*)$": "$1"
    },
    "transform": {
      "^.+\\.(js|mjs)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@jest)/)"
    ]
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  }
}
