{
  "name": "rnk-vortex-system-optimizer",
  "version": "3.1.0",
  "description": "RNK Vortex System Optimizer - Advanced database optimization with LISA AI integration",
  "type": "module",
  "scripts": {
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "parity": "node scripts/check-stack-parity.js",
    "pretest": "node scripts/check-stack-parity.js",
    "sync-stacks": "node scripts/sync-stacks-cli.js",
    "bench": "node scripts/benchmark-core.js",
    "test:nightly": "node scripts/run-nightly.js",
    "lint": "eslint scripts/**/*.js native/**/*.js",
    "lint:fix": "eslint scripts/**/*.js native/**/*.js --fix",
    "native:facts": "node native/cli.mjs facts",
    "native:optimize": "node native/cli.mjs optimize",
    "native:cache:preview": "node native/cli.mjs cache-preview",
    "native:organize:preview": "node native/cli.mjs organize-preview"
  },
  "keywords": [
    "foundry-vtt",
    "optimization",
    "performance",
    "rnk-vortex"
  ],
  "author": "RNK Vortex",
  "license": "GPL-3.0-only",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@rnk/vq-contract-tests": "file:vendor/vq-contract-tests",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "collectCoverageFrom": [
      "scripts/gm-hub.js",
      "scripts/telemetry.js",
      "scripts/foundry-action-host.js",
      "scripts/settings-manager.js",
      "scripts/browser-environment.js",
      "scripts/pc-host.js",
      "native/agent.js",
      "native/cache-cleaner.js",
      "native/command-runner.js",
      "native/linux-adapter.js",
      "native/organizer.js",
      "native/platform.js",
      "native/protocol.js",
      "native/system-facts.js",
      "native/windows-adapter.js",
      "!scripts/main.js",
      "!scripts/gm-hub-ui.js"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/nightly/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^file://(.*)$": "$1"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@jest)/)"
    ]
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  }
}
