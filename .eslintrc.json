{
  "env": {
    "es2022": true,
    "node": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-async-promise-executor": "error",
    "no-constant-condition": "error",
    "no-duplicate-imports": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none" }]
  }
}
